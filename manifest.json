{
  "manifest_version": 3,
  "name": "PRaise",
  "version": "0.1.0",
  "description": "Positive PR affirmations: right-click in a GitHub pull request comment box to insert a friendly LGTM message.",
  "permissions": ["contextMenus"],
  "host_permissions": ["https://text.pollinations.ai/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://github.com/*"], "js": ["src/content.js"], "run_at": "document_idle" }
  ]
}
